# ── Core Server Config ───────────────────────────────────────────────
NODE_ENV="production"
PORT=4000
FRONTEND_URL="https://your-production-domain.com" # Change to your actual live domain (e.g. https://trevoros.com)

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# ── Security & Authentication ─────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ── Payment Gateway (Razorpay) ────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxx"

# ── OAuth Providers ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# ── Email Service (Resend) ────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ── WhatsApp Group Links ──────────────────────────────────────────────
WHATSAPP_FOUNDATION_URL="https://chat.whatsapp.com/invite/YOUR_FOUNDATION_LINK"
WHATSAPP_BUILDER_URL="https://chat.whatsapp.com/invite/YOUR_BUILDER_LINK"
