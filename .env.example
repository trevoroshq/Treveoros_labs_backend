# ── Database (Neon) ───────────────────────────────────────────────────
# Pooled URL — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct URL — used by prisma db push / prisma migrate (bypasses pooler)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-64-byte-random-hex-string"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL="https://labs.trevoros.com"
BACKEND_URL="https://api.labs.trevoros.com"

# ── Razorpay ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# ── Resend (Email) ────────────────────────────────────────────────────
RESEND_API_KEY="re_replace-with-resend-api-key"
RESEND_FROM_EMAIL="TREVOROS LABS <admissions@trevoros.com>"

# ── WhatsApp Group Links ──────────────────────────────────────────────
WHATSAPP_FOUNDATION_URL="https://chat.whatsapp.com/invite/YOUR_FOUNDATION_LINK"
WHATSAPP_BUILDER_URL="https://chat.whatsapp.com/invite/YOUR_BUILDER_LINK"
